[Unit]
Description=LifeOS FastAPI Backend
After=network.target

[Service]
Type=simple
User=quandoan
WorkingDirectory=/home/quandoan/Projects/lifeos/backend
EnvironmentFile=/home/quandoan/Projects/lifeos/.env
ExecStart=/home/quandoan/Projects/lifeos/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
